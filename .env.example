NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values. Do not expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Add these in the payment integration phase.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
PAYMENT_ENCRYPTION_KEY=
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_WEBHOOK_SECRET=

# Resend transactional email. Keep these server-only; never use NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
REQUIRE_EMAIL_DELIVERY=false

# Optional staging-only authenticated RLS matrix. Store test passwords only in the staging secret manager.
# JSON shape: [{"label":"beneficiary","email":"...","password":"...","roles":["beneficiary"]}]
RLS_TEST_USERS_JSON=
