NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public contact channels shown on the site, footer, and structured data.
# Use official organisation numbers and inboxes, not personal ones.
# These are read at build time: rebuild after changing them.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SAFEGUARDING_EMAIL=
NEXT_PUBLIC_OFFICE_HOURS=
NEXT_PUBLIC_STREET_ADDRESS=

# Direct giving details shown on /donate whenever online checkout is not enabled.
# Use the foundation's registered paybill/till and bank account only.
NEXT_PUBLIC_MPESA_PAYBILL=
NEXT_PUBLIC_MPESA_ACCOUNT=
NEXT_PUBLIC_MPESA_TILL=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BRANCH=
NEXT_PUBLIC_BANK_SWIFT=

# Server-only values. Do not expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Online checkout. Keep PAYMENT_PROVIDER_ENABLED=false in production until a
# real provider (e.g. M-Pesa Daraja STK Push) creates checkout sessions and
# posts signed events to /api/donations/webhook. Until then /donate shows the
# direct giving details above.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
PAYMENT_ENCRYPTION_KEY=
PAYMENT_PROVIDER_ENABLED=false
PAYMENT_WEBHOOK_SECRET=

# Resend transactional email. Keep these server-only; never use NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
REQUIRE_EMAIL_DELIVERY=false

# Optional staging-only authenticated RLS matrix. Store test passwords only in the staging secret manager.
# JSON shape: [{"label":"beneficiary","email":"...","password":"...","roles":["beneficiary"]}]
RLS_TEST_USERS_JSON=
