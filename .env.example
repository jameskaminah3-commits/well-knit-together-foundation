NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public contact channels shown on the site, footer, and structured data.
# Use official organisation numbers and inboxes, not personal ones.
# These are read at build time: rebuild after changing them.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SAFEGUARDING_EMAIL=
NEXT_PUBLIC_OFFICE_HOURS=
NEXT_PUBLIC_STREET_ADDRESS=

# Fallback giving details for /donate. Payment settings in the workspace override these.
# Use the foundation's registered paybill/till and bank account only.
NEXT_PUBLIC_MPESA_PAYBILL=
NEXT_PUBLIC_MPESA_ACCOUNT=
NEXT_PUBLIC_MPESA_TILL=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BRANCH=
NEXT_PUBLIC_BANK_SWIFT=

# Server-only values. Do not expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Payments. The super administrator manages giving details, M-Pesa Daraja
# credentials, and the online giving switch in the workspace
# (Payment settings). These server values are required for that to work:
# 32+ random characters; encrypts M-Pesa secrets at rest.
PAYMENT_ENCRYPTION_KEY=
# Signs the generic payment webhook and derives the M-Pesa callback URL token.
PAYMENT_WEBHOOK_SECRET=
# Set to true to stop all online payments immediately.
PAYMENTS_KILL_SWITCH=false
# Optional fallback if credentials are not saved in Payment settings:
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=

# Resend transactional email. Keep these server-only; never use NEXT_PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=
REQUIRE_EMAIL_DELIVERY=false

# Optional staging-only authenticated RLS matrix. Store test passwords only in the staging secret manager.
# JSON shape: [{"label":"beneficiary","email":"...","password":"...","roles":["beneficiary"]}]
RLS_TEST_USERS_JSON=
